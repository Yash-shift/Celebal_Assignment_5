Q15: Final Processing Pipeline

Requirements:

Remove duplicates
Fill null prices with 0
Group by store_id
Calculate total revenue
from pyspark.sql.functions import sum

result = (
    df.dropDuplicates()
      .na.fill({"price": 0})
      .groupBy("store_id")
      .agg(
          sum("price").alias("total_revenue")
      )
      .orderBy("store_id")
)

result.show()
